{
  "consumer": {
    "name": "WeatherAggregator"
  },
  "interactions": [
    {
      "description": "a request to find a city",
      "pending": false,
      "request": {
        "method": "GET",
        "path": "/v1/search",
        "query": {
          "count": [
            "1"
          ],
          "format": [
            "json"
          ],
          "language": [
            "en"
          ],
          "name": [
            "Belagavi"
          ]
        }
      },
      "response": {
        "body": {
          "content": {
            "results": [
              {
                "latitude": 15.8497,
                "longitude": 74.4977
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request to get current weather",
      "pending": false,
      "request": {
        "method": "GET",
        "path": "/v1/forecast",
        "query": {
          "current_weather": [
            "true"
          ],
          "latitude": [
            "15.8497"
          ],
          "longitude": [
            "74.4977"
          ],
          "wind_speed_unit": [
            "kmh"
          ]
        }
      },
      "response": {
        "body": {
          "content": {
            "current_weather": {
              "temperature": 25.0,
              "weathercode": 0,
              "windspeed": 10.0
            }
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "OpenMeteo"
  }
}